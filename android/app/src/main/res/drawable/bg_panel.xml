<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- sombra magenta desplazada + panel con borde cian: efecto neon -->
    <item android:left="3dp" android:top="3dp">
        <shape android:shape="rectangle">
            <solid android:color="#00000000" />
            <stroke android:width="1dp" android:color="@color/neon_magenta" />
        </shape>
    </item>
    <item android:right="3dp" android:bottom="3dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/surface_glass" />
            <stroke android:width="1dp" android:color="@color/neon_cyan" />
        </shape>
    </item>
</layer-list>
