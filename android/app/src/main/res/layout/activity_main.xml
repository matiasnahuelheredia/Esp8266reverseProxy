<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg">

    <com.esp8266.reverseproxy.CyberBackgroundView
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:fitsSystemWindows="true">

    <LinearLayout
        android:id="@+id/content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <com.esp8266.reverseproxy.GlitchTextView android:id="@+id/tvTitle" style="@style/Cyber.Title" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="ESP//PROXY" />
        <TextView style="@style/Cyber.Subtitle" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="4dp"
            android:text="&gt; NEURAL LINK v2.0 // ESP32 BRIDGE" />
        <View android:id="@+id/neonLine" android:layout_width="match_parent" android:layout_height="2dp"
            android:layout_marginTop="12dp" android:background="@drawable/bg_neon_line" />

        <LinearLayout
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="20dp" android:background="@drawable/bg_panel"
            android:orientation="vertical" android:padding="16dp"
            android:divider="@drawable/div_v" android:showDividers="middle">
            <TextView style="@style/Cyber.Section" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:text="// 01 ENLACE BLUETOOTH" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:background="@drawable/bg_input">
                <Spinner android:id="@+id/spinnerDevices" android:layout_width="match_parent"
                    android:layout_height="48dp" android:popupBackground="@color/surface" />
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:divider="@drawable/div_v" android:showDividers="middle">
                <Button android:id="@+id/btnRefresh" style="@style/Cyber.Button" android:layout_width="0dp"
                    android:layout_height="wrap_content" android:layout_weight="1" android:text="Actualizar" />
                <Button android:id="@+id/btnConnect" style="@style/Cyber.Button.Hot" android:layout_width="0dp"
                    android:layout_height="wrap_content" android:layout_weight="1" android:text="Conectar" />
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:background="@drawable/bg_terminal" android:gravity="center_vertical"
                android:orientation="horizontal" android:padding="12dp">
                <com.esp8266.reverseproxy.LinkIndicatorView android:id="@+id/linkIndicator"
                    android:layout_width="36dp" android:layout_height="36dp" />
                <TextView android:id="@+id/tvState" style="@style/Cyber.Terminal"
                    android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_marginStart="12dp" android:layout_weight="1" android:text="Desconectado" />
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:divider="@drawable/div_v" android:showDividers="middle">
                <Button android:id="@+id/btnStatus" style="@style/Cyber.Button" android:layout_width="0dp"
                    android:layout_height="wrap_content" android:layout_weight="1" android:text="Estado" />
                <Button android:id="@+id/btnReboot" style="@style/Cyber.Button" android:layout_width="0dp"
                    android:layout_height="wrap_content" android:layout_weight="1" android:text="Reiniciar" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="20dp" android:background="@drawable/bg_panel"
            android:orientation="vertical" android:padding="16dp"
            android:divider="@drawable/div_v" android:showDividers="middle">
            <TextView style="@style/Cyber.Section" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:text="// 02 CONFIGURACION DEL NODO" />
            <EditText android:id="@+id/etSsid" style="@style/Cyber.Input" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:hint="SSID de la red WiFi" android:inputType="text"
                android:autofillHints="" />
            <EditText android:id="@+id/etPass" style="@style/Cyber.Input" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:hint="Contrasena WiFi" android:inputType="textPassword"
                android:autofillHints="" />
            <EditText android:id="@+id/etHost" style="@style/Cyber.Input" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:hint="Destino del proxy (IP o dominio)" android:inputType="textUri"
                android:autofillHints="" />
            <EditText android:id="@+id/etPort" style="@style/Cyber.Input" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:hint="Puerto destino" android:inputType="number"
                android:autofillHints="" />
            <EditText android:id="@+id/etListen" style="@style/Cyber.Input" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:hint="Puerto de escucha del ESP32" android:inputType="number"
                android:autofillHints="" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:divider="@drawable/div_v" android:showDividers="middle">
                <Button android:id="@+id/btnScan" style="@style/Cyber.Button" android:layout_width="0dp"
                    android:layout_height="wrap_content" android:layout_weight="1" android:text="Buscar redes" />
                <Button android:id="@+id/btnLoad" style="@style/Cyber.Button" android:layout_width="0dp"
                    android:layout_height="wrap_content" android:layout_weight="1" android:text="Leer" />
                <Button android:id="@+id/btnSave" style="@style/Cyber.Button.Hot" android:layout_width="0dp"
                    android:layout_height="wrap_content" android:layout_weight="1" android:text="Guardar" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="20dp" android:background="@drawable/bg_panel"
            android:orientation="vertical" android:padding="16dp"
            android:divider="@drawable/div_v" android:showDividers="middle">
            <TextView style="@style/Cyber.Section" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:text="// 03 FLASHEO DE FIRMWARE (.BIN)" />
            <TextView android:id="@+id/tvFile" style="@style/Cyber.Body" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:text="Ningun archivo" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:divider="@drawable/div_v" android:showDividers="middle">
                <Button android:id="@+id/btnPick" style="@style/Cyber.Button" android:layout_width="0dp"
                    android:layout_height="wrap_content" android:layout_weight="1" android:text="Elegir .bin" />
                <Button android:id="@+id/btnUpload" style="@style/Cyber.Button.Hot" android:layout_width="0dp"
                    android:layout_height="wrap_content" android:layout_weight="1" android:text="Subir" />
            </LinearLayout>
            <ProgressBar android:id="@+id/progress" style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent" android:layout_height="wrap_content" android:max="100"
                android:progressTint="@color/neon_magenta" android:progressBackgroundTint="@color/dim" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="20dp" android:background="@drawable/bg_panel"
            android:orientation="vertical" android:padding="16dp"
            android:divider="@drawable/div_v" android:showDividers="middle">
            <TextView style="@style/Cyber.Section" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:text="// CONSOLA" />
            <TextView android:id="@+id/tvLog" style="@style/Cyber.Terminal" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:background="@drawable/bg_terminal"
                android:minHeight="120dp" android:padding="12dp" android:textIsSelectable="true" />
        </LinearLayout>
    </LinearLayout>
    </ScrollView>
</FrameLayout>
